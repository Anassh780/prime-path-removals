# ---------------------------------------------------------------------------
# Prime House Removals — environment configuration
# Copy to .env.local and fill in the values you have.
# The site runs fully without these: forms fall back to a documented
# "not configured" state instead of pretending a submission succeeded.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://primehouseremovals.co.uk

# --- Business contact details (rendered only when provided) ----------------
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=

# --- Supabase (quote + contact submission storage) -------------------------
# When both values are present, form submissions are persisted to the
# `quote_requests` / `contact_messages` tables. Otherwise the API routes
# return a 503 and the UI shows an honest "not connected" error.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (optional) ---------------------------------------
# If unset, submissions are stored only (Supabase) and no email is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=quotes@primehouseremovals.co.uk
QUOTE_NOTIFICATION_EMAIL=
